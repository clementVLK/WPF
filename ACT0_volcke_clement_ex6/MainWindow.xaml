<Window x:Class="ACT0_volcke_clement_ex6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ACT0_volcke_clement_ex6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <ListBox Width="200"
                 Height="80"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <ListBoxItem Foreground="#FF8B4513">
                Danse macabre
            </ListBoxItem>

            <ListBoxItem Foreground="#FF00CC00">
                Toccata et Fugue en ré mineur
            </ListBoxItem>

            <ListBoxItem Foreground="#FF0066FF">
                L'empereur
            </ListBoxItem>

            <ListBoxItem Foreground="#FF66CCCC">
                Tristesse
            </ListBoxItem>

            <ListBoxItem Foreground="#FFFF9900">
                La Lettre à Élise
            </ListBoxItem>

            <ListBoxItem Foreground="#FFCC66CC">
                Clair de lune
            </ListBoxItem>

            <ListBoxItem Foreground="#FF999999">
                Nocturne
            </ListBoxItem>

        </ListBox>

    </Grid>
</Window>
