<Window x:Class="ACT1_volcke_clement_ex1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ACT1_volcke_clement_ex1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Button Height="100" Content="Bouton 1"/>
            <Button Height="100" Content="Bouton 2"/>
        </StackPanel>
        <DockPanel Grid.Row="0" Grid.Column="1">

            <Button DockPanel.Dock="Top"
                    Height="40"
                    Content="Top"/>

            <Button DockPanel.Dock="Bottom"
                    Height="40"
                    Content="Bottom"/>

            <Button DockPanel.Dock="Left"
                    Width="40"
                    Content="Left"/>

            <Button DockPanel.Dock="Right"
                    Width="40"
                    Content="Right"/>

            <Button Content="Direction"/>
        </DockPanel>
        <WrapPanel Grid.Row="1"
                   Grid.Column="0"
                   Width="240"
                   Height="80"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <Button Width="80" Height="20" Content="Bouton 1"/>
            <Button Width="80" Height="20" Content="Bouton 2"/>
            <Button Width="80" Height="20" Content="Bouton 3"/>
            <Button Width="80" Height="60" Content="Bouton 4"/>
            <Button Width="80" Height="60" Content="Bouton 5"/>
            <Button Width="80" Height="60" Content="Bouton 6"/>
        </WrapPanel>
        <Canvas Grid.Row="1"
                Grid.Column="1">

            <Ellipse Width="120"
                Height="120"
                Fill="Black"
                Canvas.Left="90"
                Canvas.Top="40"/>
            <Ellipse Width="80"
                Height="80"
                Fill="Yellow"
                Canvas.Left="110"
                Canvas.Top="60"/>


            <Ellipse Width="40"
                     Height="40"
                     Fill="Red"
                     Canvas.Left="130"
                     Canvas.Top="80"/>
        </Canvas>


    </Grid>
</Window>
