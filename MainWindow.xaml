<Window x:Class="WPF_ACT2_EVENTS1_volcke_clement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_ACT2_EVENTS1_volcke_clement"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#A5B2B2">

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Content="A"
               FontSize="40"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <TextBox x:Name="txtA"
                 Grid.Row="0"
                 Grid.Column="1"
                 Width="165"
                 Height="62"
                 FontSize="30"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"/>

        <Label Grid.Row="1"
               Grid.Column="0"
               Content="B"
               FontSize="40"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <TextBox x:Name="txtB"
                 Grid.Row="1"
                 Grid.Column="1"
                 Width="165"
                 Height="62"
                 FontSize="30"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"/>

        <Label Grid.Row="2"
               Grid.Column="0"
               Content="C"
               FontSize="40"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <TextBox x:Name="txtC"
                 Grid.Row="2"
                 Grid.Column="1"
                 Width="165"
                 Height="62"
                 FontSize="30"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"/>
        
        <Button x:Name="btnCalculer"
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="CALCULER"
                Width="200"
                Height="60"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Click="btnCalculer_Click"
                MouseEnter="btnCalculer_MouseEnter"
                MouseLeave="btnCalculer_MouseLeave"/>

        <Button x:Name="btnV"
                Grid.Row="3"
                Grid.Column="2"
                Content="V"
                Width="40"
                Height="60"
                FontSize="25"
                FontWeight="Bold"
                Visibility="Collapsed"/>

    </Grid>

</Window>
