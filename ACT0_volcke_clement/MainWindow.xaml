<Window x:Class="ACT0_volcke_clement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ACT0_volcke_clement"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="up left" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="Red" />
        <Button Content="up right" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="Green"/>
        <Button Content="down left" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="Blue"/>
        <Button Content="down right" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="Purple"/>
    </Grid>
</Window>
